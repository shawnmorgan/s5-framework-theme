<?xml version="1.0"?>
<ruleset name="S5">
	<description>Coding standard for the S5 framework (theme + plugin).</description>

	<file>../s5-theme</file>
	<file>src</file>
	<file>cli</file>
	<file>templates</file>
	<file>s5-plugin.php</file>
	<file>tests</file>
	<file>../tests</file>

	<!-- Ignore build/vendor output. -->
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/dist/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<!-- WordPress standard. -->
	<rule ref="WordPress">
		<!--
			PSR-4 autoloading (Composer) requires StudlyCase class files named
			after the class (Plugin.php, HelloCommand.php). That is mutually
			exclusive with WPCS's legacy "class-*.php / lowercase-hyphenated"
			file-naming sniffs, so they are disabled project-wide. This is the
			standard reconciliation for a Composer/PSR-4 WordPress plugin.
		-->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
	</rule>

	<!-- Text domain for i18n checks. -->
	<config name="text_domain" value="s5"/>

	<!-- Minimum supported PHP version for compatibility checks. -->
	<config name="testVersion" value="8.1-"/>
	<rule ref="PHPCompatibilityWP"/>

	<!--
		's5' / 'S5' is the deliberate placeholder product identity (PRD Open
		Question #1). Allowlist it so PrefixAllGlobals accepts it despite the
		<4-char default minimum.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="s5"/>
				<element value="S5"/>
			</property>
		</properties>
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals.ShortPrefixPassed"/>
	</rule>

	<!--
		WP-CLI command __invoke( $args, $assoc_args ) has a fixed signature;
		unused positional/assoc args in a no-op command are required, not dead
		code.
	-->
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
		<exclude-pattern>cli/*</exclude-pattern>
	</rule>

	<!--
		HtmlDocument reads PHP's built-in DOM API, whose property names
		(childNodes, nodeName, textContent, ownerDocument) are fixed by the
		engine and cannot be snake_case. The sniff misfires on these; scope it
		out for that one file.
	-->
	<rule ref="WordPress.NamingConventions.ValidVariableName.UsedPropertyNotSnakeCase">
		<exclude-pattern>src/HtmlDocument.php</exclude-pattern>
	</rule>

	<!--
		The importer reads LOCAL source files with file_get_contents(); the
		wp_remote_get() alternative is for remote URLs only and does not apply.
	-->
	<rule ref="WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents">
		<exclude-pattern>cli/ImportCommand.php</exclude-pattern>
		<exclude-pattern>../tests/lib/extract-head.php</exclude-pattern>
	</rule>

	<!--
		tests/lib/extract-head.php is a STANDALONE host-side CLI helper for the
		round-trip harness. It never boots WordPress, so the WP-runtime sniffs
		misfire: it legitimately `echo`s parsed values to stdout (it is a CLI
		filter, not HTML output), uses fwrite()/file_get_contents() for local
		files (no WP_Filesystem available), and its `$tag` loop variable is a
		local match string, not the WP `$tag` global. Scope these out for that
		one test-only file. This is not framework code and is never shipped.
	-->
	<rule ref="WordPress.Security.EscapeOutput.OutputNotEscaped">
		<exclude-pattern>../tests/lib/extract-head.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.GlobalVariablesOverride.Prohibited">
		<exclude-pattern>../tests/lib/extract-head.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions.file_system_operations_fwrite">
		<exclude-pattern>../tests/lib/extract-head.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions.file_system_read_fwrite">
		<exclude-pattern>../tests/lib/extract-head.php</exclude-pattern>
	</rule>

	<!--
		The test-only debug guard intentionally calls error_reporting() to make
		notices visible to the acceptance test. It is never shipped, so the
		path-disclosure / runtime-config warnings do not apply.
	-->
	<rule ref="WordPress.PHP.DevelopmentFunctions.prevent_path_disclosure_error_reporting">
		<exclude-pattern>../tests/mu-plugins/s5-debug-guard.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.runtime_configuration_error_reporting">
		<exclude-pattern>../tests/mu-plugins/s5-debug-guard.php</exclude-pattern>
	</rule>
</ruleset>
