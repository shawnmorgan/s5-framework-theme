{
  "name": "s5-framework",
  "version": "0.0.0",
  "private": true,
  "description": "Agent-Native WordPress Framework (S5) \u2014 dev environment and test harness.",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:destroy": "wp-env destroy",
    "env:cli": "wp-env run cli wp",
    "build:zip": "node tools/build-zip.mjs",
    "test": "bash tests/run-all.sh",
    "test:dist": "bash tests/acceptance-dist.sh",
    "test:phase-a": "bash tests/acceptance-phase-a.sh",
    "test:reuse": "SKIP_DESTROY=1 bash tests/run-all.sh",
    "test:phpunit": "wp-env run tests-cli --env-cwd=wp-content/themes/s5-theme vendor/bin/phpunit",
    "lint": "wp-env run cli --env-cwd=wp-content/themes/s5-theme composer lint",
    "test:step0": "bash tests/acceptance.sh",
    "test:step1": "bash tests/acceptance-step1.sh",
    "test:step2": "bash tests/acceptance-step2.sh",
    "test:step3": "bash tests/acceptance-step3.sh",
    "test:roundtrip": "bash tests/acceptance-step3.sh",
    "test:step4": "bash tests/acceptance-step4.sh",
    "test:step5": "bash tests/acceptance-step5.sh",
    "test:step6": "bash tests/acceptance-step6.sh",
    "test:step8": "bash tests/acceptance-step8.sh",
    "test:step9": "bash tests/acceptance-step9.sh",
    "test:step10": "bash tests/acceptance-step10.sh",
    "test:step11": "bash tests/acceptance-step11.sh",
    "test:components": "bash tests/acceptance-components.sh",
    "test:editor": "bash tests/acceptance-editor.sh",
    "validate": "wp-env run cli wp s5 validate wp-content/s5-pages",
    "recompile": "wp-env run cli wp s5 recompile --all",
    "test:disable": "bash tests/acceptance-disable.sh"
  },
  "devDependencies": {
    "@wordpress/env": "^10.0.0"
  }
}
